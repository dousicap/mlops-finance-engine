{
  "uid": "finml-api",
  "title": "finml - API de prédiction",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "finml",
    "mlops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prédictions par seconde",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase) (rate(finml_predictions_total[5m]))",
          "legendFormat": "{{usecase}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Erreurs par cause",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase, raison) (rate(finml_prediction_errors_total[5m]))",
          "legendFormat": "{{usecase}} {{raison}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latence p50 et p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, usecase) (rate(finml_prediction_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{usecase}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, usecase) (rate(finml_prediction_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{usecase}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Score moyen en sortie du modèle",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase) (rate(finml_prediction_score_sum[15m])) / sum by (usecase) (rate(finml_prediction_score_count[15m]))",
          "legendFormat": "{{usecase}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Version servie",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (usecase, version, candidat) (finml_model_info)",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}